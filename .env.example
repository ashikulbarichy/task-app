# API & Networking
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_API_TIMEOUT_MS=15000
EXPO_PUBLIC_USE_IN_APP_MOCK=true

# Push Notifications & Deep Linking
EXPO_PUBLIC_NOTIFICATION_CHANNEL_ID=delivery-updates
EXPO_PUBLIC_APP_SCHEME=dnpdelivery

# Cache & React Query Defaults
EXPO_PUBLIC_DEFAULT_STALE_TIME_MS=30000

# Diagnostics & Logging
EXPO_PUBLIC_ENABLE_DEBUG_LOGS=true

# Mock Backend Server (Node.js)
MOCK_SERVER_PORT=3000
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
